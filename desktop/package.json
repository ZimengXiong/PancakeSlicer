{
  "name": "pancakeslicer-desktop",
  "productName": "PancakeSlicer",
  "version": "0.4.2",
  "private": true,
  "description": "PancakeSlicer desktop with a local slicing service and native engine",
  "author": "Zimeng Xiong",
  "license": "AGPL-3.0-only",
  "main": "out/main.js",
  "scripts": {
    "compile": "tsc -p .",
    "start": "tsc -p . && electron .",
    "dist:mac": "tsc -p . && electron-builder --mac --arm64 --publish never",
    "dist:win": "tsc -p . && electron-builder --win --x64 --publish never",
    "dist:mac-x64": "tsc -p . && electron-builder --mac --x64 --publish never",
    "dist:linux-x64": "tsc -p . && electron-builder --linux --x64 --publish never",
    "dist:linux-arm64": "tsc -p . && electron-builder --linux --arm64 --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "electron@45.2.1": true
  },
  "build": {
    "appId": "com.pancakeslicer.desktop",
    "productName": "PancakeSlicer",
    "artifactName": "PancakeSlicer-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json",
      "!**/*.map",
      "!**/*.pdb",
      "!**/*.d.ts"
    ],
    "extraResources": [
      {
        "from": "build/web",
        "to": "web"
      },
      {
        "from": "build/engine-${os}-${arch}",
        "to": "engine"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      }
    ],
    "asarUnpack": [],
    "electronLanguages": [
      "en-US"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "signIgnore": [
        "Contents/Resources/engine/.*"
      ]
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "publish": null,
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "executableName": "pancakeslicer",
      "synopsis": "Non-planar 3D printing slicer",
      "maintainer": "Zimeng Xiong <zxzimeng@gmail.com>",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnss3",
        "libxss1",
        "libasound2 | libasound2t64",
        "libgbm1"
      ]
    }
  },
  "homepage": "https://github.com/ZimengXiong/PancakeSlicer",
  "desktopName": "pancakeslicer.desktop"
}
